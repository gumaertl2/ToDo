// [2026-07-24] - BUGFIX: Cache-Control Header für index.html und sw.js hinzugefügt, um Vercel-Caching zu umgehen und PWA-Updates zu erzwingen.
{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
// --- END OF FILE ---