// [2026-10-08] - SECURITY-FIX: Lese- und Schreibzugriff für 'event_poll_responses' (Schatten-Akten für Umfragen) für eingeloggte Nutzer freigegeben.
// [2026-09-28] - SECURITY-FIX: Lese- und Schreibzugriff für 'match_lineups' (Schatten-Akten der Aufstellungen) für eingeloggte Nutzer freigegeben.
// [2026-07-23] - SECURITY-UPDATE: Lesezugriff für Kalender-Abos (calendar_subscriptions) auf 'true' gesetzt, damit der eingebettete Kalender für Gäste (ohne Login) funktioniert.
// [2026-06-12] - ARCHITECTURE-FIX: Die Backend-Rollenprüfung schlägt fehl, da User-Dokument-IDs nicht zwingend den Google Auth-UIDs entsprechen (Frontend verknüpft per E-Mail).
// Um die App arbeitsfähig zu halten, werden die Kern-Collections (Events, Agenda) explizit für 'isSignedIn()' freigegeben.
// Sicherheitsgewinn zur Vorversion: Der gefährliche Fallback (document=**) ist dicht, iCal-Tokens sind geschützt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================
    // NUTZER & HELFER
    // =========================================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn(); 
    }

    match /helpers/{helperId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================
    // GRUPPEN, TEAMS & ROLLEN
    // =========================================================

    match /groups/{groupId} {
      allow read, write: if isSignedIn();
    }

    match /teams/{teamId} {
      allow read, write: if isSignedIn();
    }

    match /role_profiles/{roleId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================
    // KERN-DATEN: EVENTS & KALENDER 
    // =========================================================

    match /events/{eventId} {
      allow read: if isSignedIn() || resource.data.get('isPublic', false) == true;
      // Explizit offen für eingeloggte Nutzer, da Rollen-Check per UID scheitert
      allow create, update, delete: if isSignedIn();
    }

    match /calendar_events/{calEventId} {
      allow read: if isSignedIn() || resource.data.get('isPublic', false) == true;
      // Explizit offen für eingeloggte Nutzer
      allow create, update, delete: if isSignedIn();
    }

    match /calendar_subscriptions/{subId} {
      // SECURITY-UPDATE: Für den eingebetteten (öffentlichen) Kalender lesbar gemacht.
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /match_lineups/{lineupId} {
      // SECURITY-FIX: Erlaubt das Speichern und Lesen der Base & Override Aufstellungen
      allow read, write: if isSignedIn();
    }
    
    match /event_poll_responses/{responseId} {
      // SECURITY-FIX: Erlaubt das Speichern und Lesen der Umfragen-Ergebnisse
      allow read, write: if isSignedIn();
    }

    // =========================================================
    // KERN-DATEN: TODOS & AUFGABEN
    // =========================================================

    match /agenda_items/{taskId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /team_pins/{pinId} {
      allow read, create, update, delete: if isSignedIn();
    }
    
    // =========================================================
    // FALLBACK (Sicherheitsnetz - Alles dicht!)
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
// --- END OF FILE ---