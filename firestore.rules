// [2026-06-11] - BUGFIX: Login-Crash endgültig behoben. Die Hilfsfunktionen 'getUserData' und 'getRolePermissions' wurden mit 'exists()' und 'isSignedIn()' Checks absolut crash-sicher gemacht, um Null-Reference-Errors beim Login-Prozess abzufangen.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HILFSFUNKTIONEN (Absolut Crash-Sicher)
    // =========================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    // CHIRURGISCHER EINGRIFF: Prüft erst, ob der Nutzer angemeldet ist UND das Dokument existiert, 
    // bevor get() aufgerufen wird. Verhindert Abstürze beim Login oder bei reinen Helfer-Accounts.
    function getUserData() {
      return (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getRolePermissions() {
      let userData = getUserData();
      let profileId = userData.get('roleProfileId', '');
      return (profileId != '' && exists(/databases/$(database)/documents/role_profiles/$(profileId)))
        ? get(/databases/$(database)/documents/role_profiles/$(profileId)).data.permissions
        : {};
    }

    function hasPermission(permKey) {
      return getRolePermissions().get(permKey, false) == true;
    }

    function isAdmin() {
      let perms = getRolePermissions();
      return isSignedIn() 
        && perms.get('deleteAnyItem', false) == true 
        && perms.get('manageEvents', false) == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================
    // NUTZER & HELFER
    // =========================================================

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /helpers/{helperId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && hasPermission('manageMitglieder'));
    }

    // =========================================================
    // GRUPPEN, TEAMS & ROLLEN
    // =========================================================

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /role_profiles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================
    // KERN-DATEN: EVENTS & KALENDER 
    // =========================================================

    match /events/{eventId} {
      allow read: if isSignedIn() || resource.data.get('isPublic', false) == true;
      allow create, update: if isSignedIn() && hasPermission('manageEvents');
      allow delete: if isAdmin();
    }

    match /calendar_events/{calEventId} {
      allow read: if isSignedIn() || resource.data.get('isPublic', false) == true;
      allow create, update: if isSignedIn() && (hasPermission('manageCalendarSetup') || hasPermission('manageEvents'));
      allow delete: if isAdmin();
    }

    match /calendar_subscriptions/{subId} {
      allow read: if true;
      allow write: if isSignedIn() && (hasPermission('manageCalendarSetup') || hasPermission('manageEvents'));
    }

    // =========================================================
    // KERN-DATEN: TODOS & AUFGABEN
    // =========================================================

    match /agenda_items/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn(); 
      allow delete: if isAdmin() || (isSignedIn() && hasPermission('deleteAnyItem'));
    }

    // =========================================================
    // TEAM-PINS (Wettkampf-Tresor)
    // =========================================================

    match /team_pins/{pinId} {
      allow read: if isSignedIn() && hasPermission('viewTeamPins');
      allow create, update: if isSignedIn() && hasPermission('manageTeamPins');
      allow delete: if isAdmin();
    }
    
    // =========================================================
    // FALLBACK (Für unentdeckte System-Kollektionen)
    // =========================================================
    // Sollte deine App noch eine andere Kollektion laden (z.B. 'settings'), 
    // die wir oben vergessen haben, fängt diese Regel das ab.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
// --- END OF FILE ---